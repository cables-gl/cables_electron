{
    "name": "cables_electron",
    "version": "0.0.1-local",
    "author": "undefined development",
    "description": "cables standalone version",
    "repository": {
        "type": "git",
        "url": "git@github.com:cables-gl/cables_electron.git"
    },
    "license": "MIT",
    "main": "src/electron/main.js",
    "type": "module",
    "engines": {
        "node": "24.18.1"
    },
    "scripts": {
        "start": "gulp watch",
        "start:help": "gulp watch --usage",
        "start:fullscreen": "gulp watch --fullscreen",
        "start:maximize": "gulp watch --maximize-renderer",
        "start:presentation": "gulp watch --fullscreen --maximize-renderer",
        "start:nodgpu": "gulp watch --dont-force-dgpu",
        "start:igpu": "gulp watch --force-igpu",
        "start:secondscreen": "gulp watch --screen=1",
        "start:screenoffset": "gulp watch --screen=-400,100",
        "build": "gulp build",
        "clean": "rimraf dist/",
        "analyze": "gulp analyze",
        "pack": "run-s clean build _pack",
        "pack:mac": "run-s clean build _pack:mac",
        "pack:win": "run-s clean build _pack:win",
        "pack:linux": "run-s clean build _pack:linux",
        "_pack": "electron-builder -mwl --dir",
        "_pack:mac": "electron-builder -m --dir -c.mac.identity=null",
        "_pack:win": "electron-builder -w --dir",
        "_pack:linux": "electron-builder -l --dir",
        "dist": "electron-builder -mwl",
        "dist:mac": "electron-builder -m",
        "dist:win": "electron-builder -w",
        "dist:linux": "electron-builder -l"
    },
    "build": {
        "productName": "cables",
        "appId": "gl.cables.standalone",
        "nodeVersion": "24.18.1",
        "asar": true,
        "includeSubNodeModules": true,
        "electronLanguages": [
            "en-US"
        ],
        "files": [
            "src/**/*",
            "src_client/**/*",
            "views/**/*",
            "index.html",
            "dist/ui/**/*",
            "dist/ops/**/*",
            "dist/public/**/*",
            "LICENCE",
            "cables.txt",
            "cables_defaults.json",
            {
                "from": "./dist/",
                "to": "./",
                "filter": [
                    "cables.json"
                ]
            },
            {
                "from": "resources/build/",
                "to": "./node_modules/",
                "filter": [
                    "buildwatcher.js"
                ]
            },
            {
                "from": "../shared/",
                "to": "./node_modules/",
                "filter": [
                    "shared_constants.json"
                ]
            },
            {
                "from": "resources/assets/",
                "to": "resources/assets/",
                "filter": [
                    "**/*"
                ]
            }
        ],
        "directories": {
            "buildResources": "resources/build"
        },
        "fileAssociations": [
            {
                "ext": "cables",
                "name": "cables patch",
                "description": "cables patch",
                "role": "Editor",
                "rank": "Owner"
            }
        ],
        "mac": {
            "executableName": "cables",
            "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
            "hardenedRuntime": true,
            "gatekeeperAssess": false,
            "entitlements": "resources/build/entitlements.mac.plist",
            "entitlementsInherit": "resources/build/entitlements.mac.plist",
            "category": "public.app-category.developer-tools",
            "target": [
                {
                    "target": "dmg",
                    "arch": [
                        "x64",
                        "arm64"
                    ]
                }
            ]
        },
        "win": {
            "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
            "verifyUpdateCodeSignature": false,
            "signAndEditExecutable": false,
            "executableName": "cables",
            "target": [
                {
                    "target": "zip",
                    "arch": [
                        "x64"
                    ]
                }
            ]
        },
        "linux": {
            "executableName": "cables",
            "artifactName": "${productName}-${version}-${os}-x64.${ext}",
            "target": [
                {
                    "target": "AppImage",
                    "arch": [
                        "x64"
                    ]
                }
            ]
        },
        "publish": [
            "github"
        ]
    },
    "dependencies": {
        "archiver": "5.3.1",
        "cables-shared-api": "file:../shared/api",
        "cables-shared-client": "file:../shared/client",
        "chokidar": "3.6.0",
        "electron-localshortcut": "3.2.1",
        "electron-log": "5.1.5",
        "eslint": "7.32.0",
        "eslint-config-airbnb-base": "14.2.1",
        "eslint-plugin-import": "2.27.5",
        "@babel/core": "7.29.0",
        "@babel/eslint-parser": "7.28.6",
        "@babel/preset-env": "7.29.2",
        "@babel/plugin-transform-modules-systemjs": "7.29.4",
        "execa": "8.0.1",
        "fluent-ffmpeg": "^2.1.3",
        "fs-extra": "11.2.0",
        "image-size": "1.0.2",
        "jsonfile": "6.1.0",
        "import-sync": "2.2.2",
        "marked": "12.0.2",
        "md5-file": "5.0.0",
        "mime": "^4.0.4",
        "mkdirp": "2.1.3",
        "moment-mini": "2.29.4",
        "npm": "10.5.2",
        "pako": "2.1.0",
        "project-name-generator": "2.1.9",
        "sanitize-filename": "1.6.3",
        "uuid-v4": "0.1.0",
        "uglify-js": "3.18.0",
        "write-file-atomic": "6.0.0"
    },
    "devDependencies": {
        "@electron/notarize": "2.5.0",
        "@k88/module-scope-plugin": "1.1.0",
        "copy-webpack-plugin": "12.0.2",
        "electron": "43.2.0",
        "electron-builder": "25.1.8",
        "git-last-commit": "1.0.1",
        "gulp": "5.0.0",
        "gulp-rename": "2.0.0",
        "rimraf": "6.0.1",
        "npm-run-all": "4.1.5",
        "terser-webpack-plugin": "5.3.10",
        "webpack": "5.91.0",
        "webpack-bundle-analyzer": "4.10.2"
    },
    "allowScripts": {
        "fsevents@2.3.3": true,
        "electron@31.7.3": true
    }
}
